{
	"schemaVersion": 1,
	"id": "day_night_bed",
	"version": "${version}",
	"name": "Day Bed - master of the Night Bed",
	"description": "Use a vanilla bed at any time to toggle world time between day and night.",
	"authors": [
		"spicato"
	],
	"license": "CC0-1.0",
	"icon": "assets/day_night_bed/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"day_night_bed.DayNightBed"
		],
		"client": [
			"day_night_bed.DayNightBedClient"
		]
	},
	"mixins": [
		"day_night_bed.mixins.json",
		{
			"config": "day_night_bed.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
